@SGCAE.Api_HostAddress = http://localhost:5080
@identification = DEMO-001
@credentialCode = DEMO-C-001
@employeeId = 00000000-0000-0000-0000-000000000000
@accessPointId = 00000000-0000-0000-0000-000000000000
@credentialId = 00000000-0000-0000-0000-000000000000
@historyFrom = 2026-10-28T00:00:00-05:00
@historyTo = 2026-10-30T00:00:00-05:00

# Ejecutar en orden. Cambiar identification y credentialCode al repetir.
# Copiar cada Guid creado en su variable y ajustar las fechas del historial.

GET {{SGCAE.Api_HostAddress}}/health
Accept: text/plain

###

GET {{SGCAE.Api_HostAddress}}/health/db
Accept: text/plain

###

# Registrar. Copiar el id de la respuesta en employeeId.
POST {{SGCAE.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "identification": "{{identification}}",
  "firstName": "Ana",
  "lastName": "Pérez",
  "email": "ana@example.com",
  "jobTitle": "Operadora",
  "organizationalArea": "Bodega"
}

###

GET {{SGCAE.Api_HostAddress}}/api/employees/{{employeeId}}
Accept: application/json

###

GET {{SGCAE.Api_HostAddress}}/api/employees?page=1&pageSize=20
Accept: application/json

###

PUT {{SGCAE.Api_HostAddress}}/api/employees/{{employeeId}}
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Pérez",
  "email": "ana@example.com",
  "jobTitle": "Supervisora",
  "organizationalArea": "Logística"
}

###

# Registrar un punto. Copiar el id devuelto en accessPointId.
POST {{SGCAE.Api_HostAddress}}/api/access-points
Content-Type: application/json

{
  "name": "Entrada principal",
  "isEnabled": true
}

###

# Registrar un punto inicialmente deshabilitado.
POST {{SGCAE.Api_HostAddress}}/api/access-points
Content-Type: application/json

{
  "name": "Entrada secundaria",
  "isEnabled": false
}

###

GET {{SGCAE.Api_HostAddress}}/api/access-points/{{accessPointId}}
Accept: application/json

###

GET {{SGCAE.Api_HostAddress}}/api/access-points?page=1&pageSize=20
Accept: application/json

###

GET {{SGCAE.Api_HostAddress}}/api/access-points?isEnabled=true&page=1&pageSize=20
Accept: application/json

###

# Asignar a un empleado activo. Copiar el id devuelto en credentialId.
POST {{SGCAE.Api_HostAddress}}/api/credentials
Content-Type: application/json

{
  "employeeId": "{{employeeId}}",
  "code": "{{credentialCode}}"
}

###

GET {{SGCAE.Api_HostAddress}}/api/credentials/{{credentialId}}
Accept: application/json

###

GET {{SGCAE.Api_HostAddress}}/api/credentials?employeeId={{employeeId}}&status=Active&page=1&pageSize=20
Accept: application/json

###

# Para autorizar: empleado activo, credencial vigente y punto habilitado.
POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Entry"
}

###

POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Exit"
}

###

# Devuelve 201 con result Rejected y persiste el intento.
POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "UNKNOWN-{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Entry"
}

###

# Bloquear despues de comprobar las autorizaciones.
PATCH {{SGCAE.Api_HostAddress}}/api/credentials/{{credentialId}}/block

###

# 201 Rejected / BlockedCredential.
POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Entry"
}

###

PATCH {{SGCAE.Api_HostAddress}}/api/credentials/{{credentialId}}/revoke

###

# 201 Rejected / RevokedCredential.
POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Exit"
}

###

PATCH {{SGCAE.Api_HostAddress}}/api/employees/{{employeeId}}/deactivate

###

# 201 Rejected / InactiveEmployee (tiene prioridad sobre la revocacion).
POST {{SGCAE.Api_HostAddress}}/api/access-records
Content-Type: application/json

{
  "credentialCode": "{{credentialCode}}",
  "accessPointId": "{{accessPointId}}",
  "movement": "Entry"
}

###

# Historial completo, del mas reciente al mas antiguo.
GET {{SGCAE.Api_HostAddress}}/api/access-records?page=1&pageSize=20
Accept: application/json

###

# Tres rechazos del empleado y punto: primera pagina con dos elementos.
GET {{SGCAE.Api_HostAddress}}/api/access-records?employeeId={{employeeId}}&accessPointId={{accessPointId}}&result=Rejected&from={{historyFrom}}&to={{historyTo}}&page=1&pageSize=2
Accept: application/json

###

# Segunda pagina con el elemento restante (sin nuevos intentos entre consultas).
GET {{SGCAE.Api_HostAddress}}/api/access-records?employeeId={{employeeId}}&accessPointId={{accessPointId}}&result=Rejected&from={{historyFrom}}&to={{historyTo}}&page=2&pageSize=2
Accept: application/json

###

# Incluye rechazos por credenciales desconocidas, sin filtro por empleado.
GET {{SGCAE.Api_HostAddress}}/api/access-records?result=Rejected&from={{historyFrom}}&to={{historyTo}}&page=1&pageSize=20
Accept: application/json

###
